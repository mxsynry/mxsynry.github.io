{
  "name": "synchrose",
  "version": "2.0.0",
  "private": true,
  "description": "An evidence-first status index for Roblox executors.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build && node scripts/sync-static-build.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "marked": "^18.0.12",
    "svelte": "^5.57.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "jsdom": "^30.0.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
